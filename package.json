{
	"name": "review-marks",
	"version": "0.0.0",
	"private": true,
	"description": "Highlight passages in a note and attach comments that can be read inline, on hover, or in a sidebar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"obsidian": "1.7.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.1"
	}
}

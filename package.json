{
	"name": "review-marks",
	"version": "0.0.0",
	"private": true,
	"description": "Highlight passages in a note and attach comments that can be read inline, on hover, or in a sidebar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"typecheck": "tsc -noEmit && tsc -noEmit -p test/e2e",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"mocha": "^10.8.2",
		"obsidian": "1.7.2",
		"obsidian-launcher": "^3.4.0",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5",
		"wdio-obsidian-reporter": "^3.4.0",
		"wdio-obsidian-service": "^3.4.0",
		"webdriverio": "^9.32.0"
	}
}

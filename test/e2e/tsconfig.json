{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": [
			"node",
			"@wdio/globals/types",
			"@wdio/mocha-framework",
			"wdio-obsidian-service"
		]
	},
	"include": ["./**/*.ts", "../../wdio.conf.mts"]
}
